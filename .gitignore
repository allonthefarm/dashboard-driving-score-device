# --- PlatformIO build output and local editor files ---
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
# (.vscode/extensions.json is kept so the recommended extensions travel with the repo)

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# --- Compiled firmware and build artifacts ---
*.bin
*.elf
*.map
build/

# --- Personal driving data (privacy) ---
# Real logs contain GPS positions: where you live, work and drive.
# Keep real recordings in data/private/. Only fake or scrubbed
# drives (no real locations) belong in data/samples/.
data/private/
*.private.csv

# --- Secrets and local settings ---
.env
*.key
secrets.*

# --- Operating system junk ---
.DS_Store
Thumbs.db
desktop.ini
*~
